# Export these variables; .env is not loaded automatically.
RAG_DATA_DIR=data
RAG_VIEWER_DIR=viewer/dist
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_PAGES=500
RAG_MAX_IMAGE_PIXELS=40000000
RAG_MAX_ZIP_RATIO=100
RAG_MAX_ZIP_UNCOMPRESSED_BYTES=209715200
RAG_WORKER_ENABLED=true
RAG_PER_PAGE_TIMEOUT_SECONDS=30
RAG_PER_JOB_TIMEOUT_SECONDS=300
RAG_OCR_ENABLED=true
RAG_OCR_WORKERS=2
# Omit RAG_OCR_MODEL_DIR to use packaged offline models.
# A custom directory must contain det.onnx, cls.onnx, and rec.onnx.
# RAG_OCR_MODEL_DIR=/path/to/models
RAG_OCR_MIN_REGION_WIDTH=1260
RAG_OCR_TABLE_MAX_CELLS=1024
RAG_OCR_TABLE_TIMEOUT_SECONDS=10
RAG_NEAR_EMPTY_CHARACTERS=5
RAG_GARBAGE_SHARE_THRESHOLD=0.01
RAG_IMAGE_COVERAGE_THRESHOLD=0.8
RAG_MIN_WORDS_PER_AREA=0.00002
RAG_LOW_OCR_CONFIDENCE=0.7
RAG_DECORATIVE_MAX_AREA_FRACTION=0.02
